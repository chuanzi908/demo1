<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chapter03.SimpleChainMapper">

    <resultMap id="CustomerProductDetailMap" type="com.entity.CustomerProductDetail">
        <id column="id" property="id"/>
        <result column="customer_id" property="customerId"/>
        <result column="customer_name" property="customerName"/>
        <result column="customer_phone" property="customerPhone"/>
        <result column="customer_level" property="customerLevel"/>
        <result column="product_id" property="productId"/>
        <result column="product_name" property="productName"/>
        <result column="product_price" property="productPrice"/>
        <result column="product_stock" property="productStock"/>
        <result column="quantity" property="quantity"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="joinCustomerProduct">
        SELECT cp.id, cp.customer_id, cp.product_id, cp.quantity, cp.created_at,
               c.name AS customer_name, c.phone AS customer_phone, c.level AS customer_level,
               p.name AS product_name, p.price AS product_price, p.stock AS product_stock
        FROM customer_product cp
        LEFT JOIN customer c ON cp.customer_id = c.id
        LEFT JOIN product p ON cp.product_id = p.id
    </sql>

    <select id="findByCustomerIdAndProductId" resultMap="CustomerProductDetailMap">
        <include refid="joinCustomerProduct"/>
        <where>
            cp.customer_id = #{customerId}
            AND cp.product_id = #{productId}
        </where>
    </select>

    <select id="findByCustomerAndPriceRange" resultMap="CustomerProductDetailMap">
        <include refid="joinCustomerProduct"/>
        <where>
            c.name LIKE CONCAT('%', #{customerName}, '%')
            AND p.price BETWEEN #{minPrice} AND #{maxPrice}
        </where>
    </select>

    <select id="findByCustomerProductAndDate" resultMap="CustomerProductDetailMap">
        <include refid="joinCustomerProduct"/>
        <where>
            cp.customer_id = #{customerId}
            AND p.name LIKE CONCAT('%', #{productName}, '%')
            AND cp.created_at >= #{startDate}
            AND cp.created_at &lt;= #{endDate}
        </where>
    </select>

    <!-- ========== 以下为注解版已有、XML版新增 ========== -->

    <select id="findByCustomerAndProductXml" resultMap="CustomerProductDetailMap">
        <include refid="joinCustomerProduct"/>
        <where>
            c.name LIKE CONCAT('%', #{customerName}, '%')
            AND p.name LIKE CONCAT('%', #{productName}, '%')
        </where>
    </select>

    <select id="findByCustomerUserDateXml" resultMap="CustomerProductDetailMap">
        <include refid="joinCustomerProduct"/>
        <where>
            c.id = #{customerId}
            AND c.name LIKE CONCAT('%', #{customerName}, '%')
            AND cp.created_at >= #{startDate}
            AND cp.created_at &lt;= #{endDate}
        </where>
    </select>

</mapper>